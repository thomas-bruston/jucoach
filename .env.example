# ================================================
# JU COACH SPORTIF — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS COMMITTER LE FICHIER .env
# ================================================

APP_ENV=development
APP_URL=http://localhost:8081

# ---- MySQL ----

MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ju_coach
MYSQL_USER=app_user
MYSQL_PASSWORD=app_user_password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ---- PHPMailer SMTP ----

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=contact@jucoachsportif.com
MAIL_PASSWORD=changeme
MAIL_FROM=contact@jucoachsportif.com
MAIL_FROM_NAME=Ju Coach Sportif
MAIL_ADMIN=ju@jucoachsportif.com

# ---- Sécurité ----
# Clé pour les tokens CSRF (32 caractères aléatoires)

APP_SECRET=changeme_generate_a_random_32_char_string
